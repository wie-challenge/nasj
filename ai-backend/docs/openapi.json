{
  "components": {
    "schemas": {
      "Candidate": {
        "additionalProperties": false,
        "properties": {
          "availability": {
            "enum": [
              "available",
              "paused"
            ],
            "title": "Availability",
            "type": "string"
          },
          "candidate_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Candidate Id",
            "type": "string"
          },
          "committed_units_per_week": {
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Committed Units Per Week",
            "type": "integer"
          },
          "craft_ids": {
            "items": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "maxItems": 20,
            "title": "Craft Ids",
            "type": "array"
          },
          "skill_level": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Skill Level"
          },
          "weekly_capacity_units": {
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Weekly Capacity Units",
            "type": "integer"
          }
        },
        "required": [
          "candidate_id",
          "craft_ids",
          "availability",
          "weekly_capacity_units",
          "committed_units_per_week"
        ],
        "title": "Candidate",
        "type": "object"
      },
      "CandidateResult": {
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Candidate Id",
            "type": "string"
          },
          "components": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScoreComponents"
              },
              {
                "type": "null"
              }
            ]
          },
          "eligible": {
            "title": "Eligible",
            "type": "boolean"
          },
          "missing_evidence": {
            "items": {
              "type": "string"
            },
            "title": "Missing Evidence",
            "type": "array"
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank"
          },
          "reasons": {
