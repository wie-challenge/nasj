# Generate a local file with: python scripts/setup_local.py
# Put the same service key in the NestJS server-side configuration.
NASJ_AI_ENVIRONMENT=development
NASJ_AI_SERVICE_API_KEY=
NASJ_AI_MAX_REQUEST_BYTES=65536

# RabbitMQ (queue) and Redis (cache), started by compose.yaml.
NASJ_AI_RABBITMQ_USER=nasj_ai
NASJ_AI_RABBITMQ_PASSWORD=
NASJ_AI_REDIS_PASSWORD=
NASJ_AI_RABBITMQ_URL=amqp://nasj_ai:<password>@127.0.0.1:5672/nasj
NASJ_AI_REDIS_URL=redis://:<password>@127.0.0.1:6379/0

# Model. "fake" works without a key. For real answers, use your personal NVIDIA Build key:
# NASJ_AI_LLM_PROVIDER=nvidia
# NASJ_AI_LLM_API_KEY=nvapi-...
# NASJ_AI_CHAT_MODEL=<model id from build.nvidia.com>
NASJ_AI_LLM_PROVIDER=fake
NASJ_AI_LLM_REQUESTS_PER_MINUTE=35
