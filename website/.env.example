NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
POSTGRES_PASSWORD=replace_with_random_hex
DATABASE_URL=postgresql://nasj:replace_with_random_hex@127.0.0.1:5442/nasj
# Optional separate schema-owner credentials for migrate deploy:
# MIGRATION_DATABASE_URL=postgresql://migration_owner:secret@database:5432/nasj
BETTER_AUTH_SECRET=generate_48_or_more_random_characters
# Remote Arcjet is explicitly OFF locally; the PostgreSQL limiter remains active.
REQUIRE_PRIVILEGED_MFA=false
# Production requires REQUIRE_PRIVILEGED_MFA=true; development false is not pilot-ready.
ARCJET_ENABLED=false
ARCJET_KEY=
ARCJET_MODE=DRY_RUN
ARCJET_FAILURE_MODE=closed
# Explicit trusted proxy IPs/CIDRs only; empty means trust none.
TRUST_PROXY=
RATE_LOGIN_MAX=10
RATE_LOGIN_WINDOW=60
RATE_REGISTRATION_MAX=5
RATE_REGISTRATION_WINDOW=3600
RATE_RESET_MAX=5
RATE_RESET_WINDOW=3600
RATE_VERIFICATION_MAX=10
RATE_VERIFICATION_WINDOW=3600
RATE_API_MAX=120
RATE_API_WINDOW=60
RATE_ADMIN_MAX=30
RATE_ADMIN_WINDOW=60
# Showroom feedback writes are bounded separately from the generic API budget.
RATE_FEEDBACK_MAX=8
RATE_FEEDBACK_WINDOW=300
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=NASJ <noreply@nasj.local>
LOG_LEVEL=info
