{
  "name": "@nasj/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "bootstrap-admin": "tsx --env-file=../../.env src/bootstrap-admin.ts",
    "test": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx test/integration.ts",
    "test:demo": "tsx test/demo.ts",
    "test:batch5": "tsx test/batch5.ts",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "worker": "node --env-file-if-exists=../../.env dist/jobs/main.js"
  },
  "dependencies": {
    "@arcjet/nest": "1.14.1",
    "@nasj/contracts": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "jose": "6.2.13",
    "nodemailer": "10.2.1",
    "pdfkit": "^0.20.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/smtp-server": "3.5.13",
    "prisma": "7.10.1",
    "smtp-server": "3.21.1"
  }
}
