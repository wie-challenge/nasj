  corrections               ProductionProgressEvent[] @relation("ProgressCorrection")
  note                      String                    @default("")
  permissionUsed            String
  occurredAt                DateTime
  recordedAt                DateTime                  @default(now())

  @@index([batchId, recordedAt])
}

model ProductionLedgerEvent {
  id               String           @id @default(cuid())
  orderId          String
  order            CommercialOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  batchId          String?
  batch            CommercialBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  action           String
  actorId          String
  actor            User             @relation("ProductionEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  artisanProfileId String?
  source           String
  quantity         Int?
  reason           String           @default("")
  correlationId    String
  occurredAt       DateTime
  recordedAt       DateTime         @default(now())

  @@index([orderId, recordedAt])
  @@index([batchId, recordedAt])
}

model QualityInspectionAttempt {
  id             String                     @id @default(cuid())
  batchId        String
  batch          CommercialBatch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  attempt        Int
  kind           String
  priorAttemptId String?                    @unique
  priorAttempt   QualityInspectionAttempt?  @relation("Reinspection", fields: [priorAttemptId], references: [id], onDelete: Restrict)
  reinspection   QualityInspectionAttempt?  @relation("Reinspection")
