  author    User            @relation("DiscussionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  authorOrganizationId String?
  authorOrganization Organization? @relation(fields: [authorOrganizationId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime        @default(now())
  messages  DiscussionMessage[]

  @@index([orderId, createdAt])
}

model DiscussionMessage {
  id            String          @id @default(cuid())
  discussionId  String
  discussion    OrderDiscussion @relation(fields: [discussionId], references: [id], onDelete: Restrict)
  authorId      String
  author        User            @relation("DiscussionMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body          String
  internalOnly  Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@index([discussionId, createdAt])
}

model ProductionException {
  id               String   @id @default(cuid())
