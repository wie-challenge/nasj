/* ---------------------------------------------------------------- Batch 11: collaboration
 * Order-linked discussion, production exceptions, schedule revisions, counteroffers, availability
 * pauses and support cases. Every record keeps the reporter's original statement; a coordinator can
 * add to a report but never overwrite the artisan's own account of it.
 */

model OrderDiscussion {
  id        String          @id @default(cuid())
  orderId   String
  order     CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  scope     String          @default("BUYER")
