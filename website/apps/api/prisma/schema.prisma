  resolution       String   @default("")
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([batchId, status])
  @@index([orderId, status])
  affectedQuantity  Int?
  affectedDate      DateTime?
}

model ScheduleRevision {
