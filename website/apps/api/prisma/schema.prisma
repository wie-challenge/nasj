  invoiceCheckedAt   DateTime?
  invoiceCheckedById String?
  billingSnapshot    Json?
  acceptedAt         DateTime?
  assignedAt         DateTime?
  estimatedFinishAt  DateTime?
  almostReadyAt      DateTime?
  associationDelivery Json?
  nasjDelivery       Json?
  qrToken            String?              @unique
  createdById        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  items              MarketOrderItem[]
  events             MarketOrderEvent[]
  women              MarketOrderArtisan[]
  ratings            MarketOrderRating[]

  @@index([buyerOrgId, createdAt])
  @@index([associationId, status])
  @@index([status, createdAt])
}

model MarketOrderItem {
  id                String        @id @default(cuid())
  orderId           String
  order             MarketOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           MarketProduct @relation(fields: [productId], references: [id])
  name              String
  quantity          Int
  unitPriceMillimes BigInt
  unitPayMillimes   BigInt

  @@index([orderId])
}

model MarketOrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  title     String
  note      String?
  actorId   String
  actorName String
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model MarketOrderArtisan {
  id               String         @id @default(cuid())
  orderId          String
  order            MarketOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  artisanProfileId String
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id])
  recordedById     String
  payMillimes      BigInt         @default(0)
  paidRecordedAt   DateTime?
  paymentProofFileId String?
  paymentCheckedAt DateTime?
  paymentCheckedById String?
  createdAt        DateTime       @default(now())

  @@unique([orderId, artisanProfileId])
}

model MarketBillingProfile {
  id              String       @id @default(cuid())
  buyerOrgId      String       @unique
  buyerOrg        Organization @relation(fields: [buyerOrgId], references: [id])
  legalName       String
  taxId           String
  billingAddress  String
  shippingAddress String
  contactName     String
  contactPhone    String
  paymentMethod   String
  updatedAt       DateTime     @updatedAt
}

model MarketArtisanDetail {
  id               String         @id @default(cuid())
  artisanProfileId String         @unique
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id])
  idNumber         String
  phone            String?
}

model MarketOrderRating {
  id           String      @id @default(cuid())
  orderId      String
  order        MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  role         String
  stars        Int
  qualityStars Int?
  comment      String
  createdById  String
  createdAt    DateTime    @default(now())

  @@unique([orderId, role])
}

model MarketNotification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  link      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
