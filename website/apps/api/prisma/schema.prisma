model ProcurementRevision {
  id            String               @id @default(cuid())
  rfqId         String
  rfq           CommercialRfq        @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  version       Int
  authorId      String
  author        User                 @relation("RevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reason        String
  predecessorId String?              @unique
  predecessor   ProcurementRevision? @relation("RevisionChain", fields: [predecessorId], references: [id], onDelete: Restrict)
  successor     ProcurementRevision? @relation("RevisionChain")
