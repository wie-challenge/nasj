  outcome     String
  note        String                   @default("")

  @@unique([attemptId, criterionId])
}

model ShipmentPreparation {
  id        String                    @id @default(cuid())
  orderId   String
  order     CommercialOrder           @relation(fields: [orderId], references: [id], onDelete: Restrict)
