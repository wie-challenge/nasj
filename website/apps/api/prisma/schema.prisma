// Commercial relationship metadata; Organization remains the buyer identity authority.
model CommercialProspect {
 operatorOrganization Organization @relation("SalesOperator",fields:[operatorOrganizationId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 buyerOrganization Organization @relation("SalesBuyer",fields:[buyerOrganizationId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 id String @id @default(cuid())
 operatorOrganizationId String
 buyerOrganizationId String
 version Int @default(1)
 snapshot Json
 createdAt DateTime @default(now())
 revisions ProspectRevision[]
 proposals PilotProposalRevision[]
 @@unique([operatorOrganizationId,buyerOrganizationId])
 @@index([operatorOrganizationId,createdAt])
}
model ProspectRevision {
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 id String @id @default(cuid())
 prospectId String
 prospect CommercialProspect @relation(fields:[prospectId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 version Int
 snapshot Json
 actorId String
 createdAt DateTime @default(now())
 @@unique([prospectId,version])
}
model PilotProposalRevision {
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 specificationRevision ProductSpecificationRevision @relation(fields:[specificationRevisionId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 rfq CommercialRfq? @relation(fields:[rfqId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 id String @id @default(cuid())
 prospectId String
 prospect CommercialProspect @relation(fields:[prospectId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 groupId String
 version Int
 specificationRevisionId String
 rfqId String?
 snapshot Json
 actorId String
 createdAt DateTime @default(now())
 @@unique([groupId,version])
 @@index([prospectId,createdAt])
}

// Evidence transcription/correction history; never changes an accepted agreement or verifies payment.
model ContractualDueDate {
 id String @id @default(cuid())
 payableId String
 payable ArtisanPayable @relation(fields:[payableId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 version Int
 basis String
 dueAt DateTime?
 contractReference String
 contractVersion String
 payableTermsSha256 String
 offerVersionAtRecording Int?
 sourceEvidence String
 evidenceStatus String @default("RECORDED_UNVERIFIED")
 reason String
 actorId String
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 correctionOfId String? @unique
 correctionOf ContractualDueDate? @relation("ContractDateCorrection",fields:[correctionOfId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 correctedBy ContractualDueDate? @relation("ContractDateCorrection")
 createdAt DateTime @default(now())
 @@unique([payableId,version])
}

// E18-06 — private buyer order feedback. A satisfaction assessment is not a claim, settlement or
// publication. The header pins order, reporter, receipt and provenance; every later change appends
// a complete revision snapshot instead of rewriting an earlier statement.
model BuyerOrderFeedback {
  id                    String   @id @default(cuid())
  orderId               String
  order                 CommercialOrder @relation("BuyerFeedbackOrder", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reporterId            String
  reporter              User     @relation("BuyerFeedbackReporter", fields: [reporterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  receiptConfirmationId String
  receiptConfirmation   BuyerDeliveryConfirmation @relation("BuyerFeedbackReceipt", fields: [receiptConfirmationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceClass           String
  scenarioId            String?
  scenario              DemoScenario? @relation("BuyerFeedbackScenario", fields: [scenarioId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt             DateTime @default(now())
  currentVersion        Int      @default(1)
  revisions             BuyerOrderFeedbackRevision[]

  @@unique([orderId, reporterId])
  @@index([orderId, createdAt, id])
  @@index([reporterId, createdAt])
}

model BuyerOrderFeedbackRevision {
  id                String   @id @default(cuid())
  feedbackId        String
  feedback          BuyerOrderFeedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  version           Int
  kind              String
  actorId           String
  actor             User     @relation("BuyerFeedbackRevisionActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt         DateTime @default(now())
  category          String
  rating            Int?
  comment           String   @default("")
  followUpStatus    String   @default("OPEN")
  followUpOwnerId   String?
  followUpOwner     User?    @relation("BuyerFeedbackFollowUpOwner", fields: [followUpOwnerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  followUpNote      String   @default("")
  linkedTicketId    String?
  linkedTicket      SupportTicket? @relation("BuyerFeedbackCaseLink", fields: [linkedTicketId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reason            String   @default("")

  @@unique([feedbackId, version])
  @@index([feedbackId, version])
  @@index([followUpOwnerId])
  @@index([linkedTicketId])
}

// E15-06 -- structured feedback about a synthetic demonstration. Deliberately separate from
// BuyerOrderFeedback (a receipt-bound commercial buyer assessment) and from SupportTicket (a claim).
// Deliberately never deleted on showroom reset: a reset archives the scenario, it does not remove it.
model DemoFeedback {
  id          String   @id @default(cuid())
  scenarioId  String
  scenario    DemoScenario @relation("DemoFeedbackScenario", fields: [scenarioId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  visitorId   String
  visitor     DemoVisitor  @relation("DemoFeedbackVisitor", fields: [visitorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  generation  Int
  sourceClass String   @default("VISITOR_SUBMITTED")
  screenKey   String
  category    String
  comment     String   @default("")
  status      String   @default("NEW")
  dedupeKey   String?
  createdAt   DateTime @default(now())
  events      DemoFeedbackEvent[]

  @@index([scenarioId, createdAt, id])
  @@index([status, createdAt])
  @@index([visitorId, createdAt])
}

model DemoFeedbackEvent {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   DemoFeedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actorId    String?
  actor      User?    @relation("DemoFeedbackEventActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  kind       String
  fromStatus String?
  toStatus   String?
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([feedbackId, createdAt, id])
  @@index([actorId, createdAt])
}

