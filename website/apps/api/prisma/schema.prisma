generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
 recordedContractualDates ContractualDueDate[]
 prospectRevisions ProspectRevision[]
 proposalRevisions PilotProposalRevision[]
  demoIdentity DemoIdentity?
  revisionsAuthored                ProcurementRevision[]       @relation("RevisionAuthor")
  procurementActivities            ProcurementActivity[]       @relation("ActivityActor")
  procurementAttachments           ProcurementAttachment[]     @relation("AttachmentAuthor")
  procurementQuestions             ProcurementQuestion[]       @relation("QuestionAuthor")
  procurementAnswers               ProcurementQuestion[]       @relation("QuestionAnswerer")
  procurementMessages              ProcurementMessage[]        @relation("MessageAuthor")
  procurementSamples               ProcurementSample[]         @relation("SampleAuthor")
  procurementDecisions             ProcurementSampleDecision[] @relation("SampleSignatory")
  procurementQuotes                ProcurementQuote[]          @relation("QuoteAuthor")
  procurementAcceptances           ProcurementAcceptance[]     @relation("QuoteSignatory")
  procurementQuoteRejections       ProcurementQuoteRejection[] @relation("QuoteRejector")
  procurementProducts              ApprovedProductVersion[]    @relation("ProductAuthor")
  procurementDocuments             ProcurementDocument[]       @relation("DocumentAuthor")
  effortAssumptions                EffortAssumption[]          @relation("EffortAuthor")
  feasibilityAssessments           FeasibilityAssessment[]     @relation("FeasibilityAuthor")
  costEstimates                    CostEstimate[]              @relation("CostAuthor")
  eligibilityAssessments           EligibilityAssessment[]     @relation("EligibilityAuthor")
  assistedDecisionsRecorded       AssistedOfferDecision[]     @relation("AssistedDecisionRecorder")
  batchReleases                    BatchRelease[]              @relation("BatchReleaseActor")
  progressReports                  ProductionProgressEvent[]   @relation("ProgressReporter")
  productionEvents                 ProductionLedgerEvent[]     @relation("ProductionEventActor")
  qualityAttempts                  QualityInspectionAttempt[]  @relation("QualityInspectorActor")
  shipmentPreparations             ShipmentPreparation[]       @relation("ShipmentPreparer")
  shipmentsCreated                 Shipment[]                  @relation("ShipmentCreator")
  pickupsCoordinated               PickupSchedule[]            @relation("PickupCoordinator")
  pickupsOperated                  PickupSchedule[]            @relation("PickupOperator")
  pickupsRecorded                  PickupSchedule[]            @relation("PickupRecorder")
  custodyHandovers                 CustodyHandover[]           @relation("CustodyActor")
  deliveryReports                  DeliveryReport[]            @relation("DeliveryReporter")
  buyerConfirmations               BuyerDeliveryConfirmation[] @relation("BuyerReceiptActor")
  buyerFeedbackReported            BuyerOrderFeedback[]        @relation("BuyerFeedbackReporter")
  buyerFeedbackRevisions           BuyerOrderFeedbackRevision[] @relation("BuyerFeedbackRevisionActor")
  buyerFeedbackFollowUps           BuyerOrderFeedbackRevision[] @relation("BuyerFeedbackFollowUpOwner")
  traceabilityPublications         TraceabilityPublication[]   @relation("TraceabilityAuthor")
  traceabilityRevisions            TraceabilityRevision[]      @relation("TraceabilityReviewer")
  settlementEvents                 SimulatedSettlementEvent[]  @relation("SettlementActor")
  artisanProfilesCreated           ArtisanProfile[]            @relation("ArtisanCreator")
  registryManagements              ArtisanManagement[]         @relation("ManagementRecorder")
  registryAssignmentsGiven         ArtisanAssignment[]         @relation("ArtisanAssigner")
  registryAssignmentsHeld          ArtisanAssignment[]         @relation("ResponsibleCoordinator")
  authorizationPoliciesReviewed    AuthorizationPolicy[]       @relation("PolicyReviewer")
  onboardingAuthorizationsRecorded OnboardingAuthorization[]   @relation("AuthorizationRecorder")
  membershipPermissionsGranted     MembershipPermission[]      @relation("PermissionGrantor")
  operatorAccounts                 OperatorAssignment[]        @relation("Operator")
  operatorAssignmentsGiven         OperatorAssignment[]        @relation("OperatorAssigner")
  concernsReviewed                 ParticipantConcern[]        @relation("ConcernReviewer")
  twoFactorEnabled                 Boolean                     @default(false)
  twoFactor                        TwoFactor?
  id                               String                      @id
  name                             String
  email                            String                      @unique
  emailVerified                    Boolean                     @default(false)
  image                            String?
  createdAt                        DateTime                    @default(now())
  updatedAt                        DateTime                    @updatedAt
  role                             Role                        @default(USER)
  status                           AccountStatus               @default(ACTIVE)
  preferredLanguage                String                      @default("en")
  organizationMemberships          OrganizationMember[]
  artisanProfile                   ArtisanProfile?
  organizationsCreated             Organization[]              @relation("OrganizationCreator")
  organizationsReviewed            Organization[]              @relation("OrganizationReviewer")
  rolesAssigned                    MembershipRole[]            @relation("RoleAssigner")
  invitationsCreated               Invitation[]
  capacityDeclarations             CapacityDeclaration[]
  delegatedGrants                  DelegationGrant[]           @relation("Delegate")
  consents                         ConsentRecord[]
  auditEvents                      AuditEvent[]
  privacyRequests                  PrivacyRequest[]            @relation("PrivacySubject")
  privacyReviews                   PrivacyRequest[]            @relation("PrivacyReviewer")
  demoFeedbackEvents               DemoFeedbackEvent[]         @relation("DemoFeedbackEventActor")
  notificationPreferences          NotificationPreference[]
  supportCases                     SupportCase[]               @relation("CaseSubject")
  assignedCases                    SupportCase[]               @relation("CaseAssignee")
  sessions                         Session[]
  accounts                         Account[]

  @@index([role, status])
  recommendationSnapshots RecommendationSnapshot[] @relation("RecommendationAuthor")
  allocationPlans         AllocationPlan[]         @relation("AllocationPlanAuthor")
  reviewedAllocationPlans AllocationPlan[]         @relation("AllocationPlanReviewer")
  allocationOverrides     AllocationOverride[]     @relation("OverrideActor")
  scheduleScenarios       ScheduleScenario[]       @relation("ScheduleScenarioAuthor")
  productSpecifications   ProductSpecification[]         @relation("SpecAuthor")
  specRevisions           ProductSpecificationRevision[] @relation("SpecRevisionAuthor")
  submittedSpecRevisions  ProductSpecificationRevision[] @relation("SpecRevisionSubmitter")
  approvedSpecRevisions   ProductSpecificationRevision[] @relation("SpecRevisionApprover")
  sampleRequests          ProductSampleRequest[]         @relation("SampleRequestAuthor")
  acceptedSampleTerms ProductSampleRequest[] @relation("SampleTermsAcceptor")
  sampleEvaluations       SampleEvaluation[]             @relation("SampleInspector")
  sampleApprovals         BuyerSampleApproval[]          @relation("SampleApprovalActor")
  discussions        OrderDiscussion[]    @relation("DiscussionAuthor")
  discussionMessages DiscussionMessage[]   @relation("DiscussionMessageAuthor")
  reportedExceptions ProductionException[] @relation("ExceptionReporter")
  coordinatedExceptions ProductionException[] @relation("ExceptionCoordinator")
  scheduleRevisions  ScheduleRevision[]   @relation("ScheduleRevisionAuthor")
  approvedScheduleRevisions ScheduleRevision[] @relation("ScheduleRevisionApprover")
  counteroffers      Counteroffer[]       @relation("CounterofferAuthor")
  reviewedCounteroffers Counteroffer[]    @relation("CounterofferReviewer")
  acceptedCounteroffers Counteroffer[]    @relation("CounterofferAcceptor")
  availabilityPauses AvailabilityPause[]  @relation("PauseAuthor")
  resumedPauses      AvailabilityPause[]  @relation("PauseResumer")
  supportTickets     SupportTicket[]      @relation("TicketReporter")
  ownedTickets       SupportTicket[]      @relation("TicketOwner")
  ticketEvents       SupportTicketEvent[] @relation("TicketEventActor")
  notifications      NotificationDelivery[] @relation("NotificationRecipient")
  supportAttachments SupportTicketAttachment[] @relation("TicketAttachmentAuthor")
  buyerScheduleRevisions   ScheduleRevision[] @relation("ScheduleRevisionBuyer")
  artisanScheduleRevisions ScheduleRevision[] @relation("ScheduleRevisionArtisan")
  forecastSnapshots     ForecastSnapshot[]   @relation("ForecastAuthor")
  timeRecords           ProductionTimeRecord[] @relation("TimeReporter")
  acknowledgedAlerts    BatchAlert[]         @relation("AlertAcknowledger")
  reviewedPolicies      ReportingPolicy[]    @relation("PolicyReviewer")
}

model Session {
  mfaVerifiedAt DateTime?
  id            String    @id
  token         String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  ipAddress     String?
  userAgent     String?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}

enum OrganizationType {
  PARTNER_COOPERATIVE
  BUYER_BUSINESS
  ASSOCIATION
  INTERNAL
}

enum ApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  LEFT
}

enum BusinessRole {
  BUYER_REPRESENTATIVE
  NASJ_OPERATOR
  BUYER
  ARTISAN
  ASSOCIATION_COORDINATOR
  PRODUCTION_MANAGER
  FINANCE_MANAGER
  QUALITY_INSPECTOR
  INVENTORY_LOGISTICS_COORDINATOR
  SUPPORT
  RESEARCHER_ANALYST
  PRODUCT_DESIGNER
  BUSINESS_DEVELOPMENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

enum AvailabilityStatus {
  AVAILABLE
  PAUSED
}

enum RelationshipStatus {
  ACTIVE
  REVOKED
}

enum DelegationScope {
  PROFILE_READ
  PROFILE_UPDATE
  SKILLS_MANAGE
  CAPACITY_READ
  CAPACITY_UPDATE
}

enum PrivacyRequestType {
  EXPORT
  CORRECTION
  DELETION
}

enum PrivacyRequestStatus {
  SUBMITTED
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Organization {
  marketProducts      MarketProduct[]
  marketCartItems     MarketCartItem[]
  marketBuyerOrders   MarketOrder[] @relation("MarketBuyer")
  marketAssociationOrders MarketOrder[] @relation("MarketAssociation")
  marketFiles         MarketFile[]
  marketBilling       MarketBillingProfile?
 salesOperatorProspects CommercialProspect[] @relation("SalesOperator")
 salesBuyerProspects CommercialProspect[] @relation("SalesBuyer")
  managingArtisans       ArtisanManagement[]
  assignedArtisans       ArtisanAssignment[]
  assignedOperators      OperatorAssignment[]
  pickupSchedules        PickupSchedule[]
  buyerRfqs              CommercialRfq[]         @relation("RfqBuyer")
  operatorRfqs           CommercialRfq[]         @relation("RfqOperator")
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  type                   OrganizationType
  approvalStatus         ApprovalStatus          @default(DRAFT)
  country                String                  @default("TN")
  region                 String
  description            String
  contactEmail           String
  contactPhone           String?
  representativeName     String
  createdByUserId        String
  createdBy              User                    @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUserId       String?
  approvedBy             User?                   @relation("OrganizationReviewer", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt             DateTime?
  approvalReason         String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  members                OrganizationMember[]
  invitations            Invitation[]
  associationMemberships AssociationMembership[]
  delegations            DelegationGrant[]
  productionOffers       CommercialOffer[]
  progressAssociations   ProductionProgressEvent[] @relation("ProgressAssociation")
  auditEvents            AuditEvent[]
  supportCases           SupportCase[]

  @@index([approvalStatus, createdAt])
  ownedProductSpecifications ProductSpecification[] @relation("ProductOwner")
  sampleRequests             ProductSampleRequest[] @relation("SampleBuyer")
  sampleRequestsAsOperator   ProductSampleRequest[] @relation("SampleOperator")
  sampleApprovals            BuyerSampleApproval[]   @relation("SampleApprovalBuyer")
  discussions        OrderDiscussion[]
  supportTickets     SupportTicket[]
}

model OrganizationMember {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  status           MembershipStatus       @default(ACTIVE)
  isManager        Boolean                @default(false)
  joinedAt         DateTime               @default(now())
  suspendedAt      DateTime?
  revokedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  roles            MembershipRole[]
  isCoordinator    Boolean                @default(false)
  permissionGrants MembershipPermission[]

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model MembershipRole {
  id               String             @id @default(cuid())
  membershipId     String
  membership       OrganizationMember @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role             BusinessRole
  assignedByUserId String
  assignedBy       User               @relation("RoleAssigner", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  assignedAt       DateTime           @default(now())

  @@unique([membershipId, role])
}

model Invitation {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email           String
  tokenHash       String           @unique
  roles           BusinessRole[]
  isManager       Boolean          @default(false)
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdByUserId String
  createdBy       User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([email, status])
}

model ArtisanProfile {
  marketOrders          MarketOrderArtisan[]
  marketDetail          MarketArtisanDetail?
  createdBy             User?                     @relation("ArtisanCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ArtisanProfile_createdById_fk")
  createdById           String?
  participantStatus     String                    @default("ACTIVE")
  managements           ArtisanManagement[]
  assignments           ArtisanAssignment[]
  authorizations        OnboardingAuthorization[]
  commercialOffers      CommercialOffer[]
  commercialBatches     CommercialBatch[]
  progressEvents        ProductionProgressEvent[]
  id                    String                    @id @default(cuid())
  userId                String?                   @unique
  user                  User?                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  displayName           String
  region                String
  preferredLanguage     String                    @default("en")
  contactPhone          String?
  contactVisibility     String                    @default("PRIVATE")
  availabilityStatus    AvailabilityStatus        @default(AVAILABLE)
  experienceDescription String                    @default("")
  equipment             String[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  skills                ArtisanSkill[]
  capacityDeclarations  CapacityDeclaration[]
  associations          AssociationMembership[]
  delegations           DelegationGrant[]
  eligibilityAssessments EligibilityAssessment[]
  payables               ArtisanPayable[]
  allocationItems       AllocationPlanItem[]
  sampleRequests        ProductSampleRequest[]
  availabilityPauses AvailabilityPause[]
  samplePayables        SamplePayable[]
  timeRecords           ProductionTimeRecord[]
}

model CraftSkill {
  rfqs        CommercialRfq[]
  id          String                @id @default(cuid())
  name        String                @unique
  category    String
  description String                @default("")
  isActive    Boolean               @default(true)
  artisans    ArtisanSkill[]
  capacities  CapacityDeclaration[]
  effortAssumptions EffortAssumption[]
  productSpecifications ProductSpecification[]
}

model ArtisanSkill {
  id               String         @id @default(cuid())
  artisanProfileId String
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  craftSkillId     String
  craftSkill       CraftSkill     @relation(fields: [craftSkillId], references: [id], onDelete: Restrict)
  proficiency      String?
  evidence         String?

  @@unique([artisanProfileId, craftSkillId])
  @@index([craftSkillId])
}

model CapacityDeclaration {
  version               Int                   @default(1)
  previousDeclarationId String?                @unique
  previousDeclaration   CapacityDeclaration?   @relation("CapacityRevision", fields: [previousDeclarationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  nextDeclaration       CapacityDeclaration?   @relation("CapacityRevision")
  authorization    OnboardingAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "CapacityDeclaration_authorizationId_fk")
  authorizationId  String?
  commercialOffers CommercialOffer[]
  supersededAt     DateTime?
  id               String                   @id @default(cuid())
  artisanProfileId String
  artisanProfile   ArtisanProfile           @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  craftSkillId     String
  craftSkill       CraftSkill               @relation(fields: [craftSkillId], references: [id], onDelete: Restrict)
  unitType         String
  quantity         Decimal                  @db.Decimal(12, 2)
  effectiveFrom    DateTime
  effectiveTo      DateTime
  declaredByUserId String
  declaredBy       User                     @relation(fields: [declaredByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime                 @default(now())

  @@index([artisanProfileId, effectiveFrom])
}

model AssociationMembership {
  id               String             @id @default(cuid())
  artisanProfileId String
  artisanProfile   ArtisanProfile     @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  status           RelationshipStatus @default(ACTIVE)
  consentRecordId  String
  consentRecord    ConsentRecord      @relation(fields: [consentRecordId], references: [id], onDelete: Restrict)
  startedAt        DateTime           @default(now())
  endedAt          DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([artisanProfileId, organizationId])
  @@index([organizationId, status])
}

model DelegationGrant {
  id               String             @id @default(cuid())
  artisanProfileId String
  artisanProfile   ArtisanProfile     @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  delegateUserId   String
  delegate         User               @relation("Delegate", fields: [delegateUserId], references: [id], onDelete: Restrict)
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scopes           DelegationScope[]
  status           RelationshipStatus @default(ACTIVE)
  grantedAt        DateTime           @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime           @default(now())

  @@index([artisanProfileId, delegateUserId, status])
  @@index([organizationId])
}

model ConsentRecord {
  id                     String                  @id @default(cuid())
  userId                 String
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose                String
  policyVersion          String
  decision               Boolean
  collectedAt            DateTime                @default(now())
  withdrawnAt            DateTime?
  collectionContext      String
  associationMemberships AssociationMembership[]

  @@index([userId, purpose])
}

model AuditEvent {
  id             String        @id @default(cuid())
  actorId        String
  actor          User          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  targetType     String
  targetId       String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  action         String
  timestamp      DateTime      @default(now())
  correlationId  String
  reason         String?
  before         Json?
  after          Json?

  @@index([organizationId, timestamp])
  @@index([actorId, timestamp])
  @@index([targetType, targetId])
}

model PrivacyRequest {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation("PrivacySubject", fields: [userId], references: [id], onDelete: Restrict)
  type                PrivacyRequestType
  status              PrivacyRequestStatus @default(SUBMITTED)
  details             String
  submittedAt         DateTime             @default(now())
  assignedReviewerId  String?
  assignedReviewer    User?                @relation("PrivacyReviewer", fields: [assignedReviewerId], references: [id], onDelete: Restrict)
  resolvedAt          DateTime?
  resolutionNotes     String?
  retentionExceptions String?

  @@index([userId, submittedAt])
  @@index([status, submittedAt])
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  language  String              @default("en")
  channel   NotificationChannel @default(EMAIL)
  category  String
  optedIn   Boolean             @default(false)
  updatedAt DateTime            @updatedAt

  @@unique([userId, channel, category])
}

model SupportCase {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation("CaseSubject", fields: [userId], references: [id], onDelete: Restrict)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subject          String
  description      String
  status           CaseStatus    @default(OPEN)
  assignedToUserId String?
  assignedTo       User?         @relation("CaseAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  resolution       String?
  dueAt            DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([organizationId, status])
}

model TwoFactor {
  id                      String    @id
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
}

// Outcome is committed atomically with the authorized capacity mutation.
model CommandOutcome {
  id          String   @id @default(cuid())
  actorId     String
  resourceId  String
  operation   String
  keyHash     String
  payloadHash String
  result      Json
  createdAt   DateTime @default(now())

  @@unique([actorId, resourceId, operation, keyHash])
}

enum OutboxStatus {
  PENDING
  RETRY
  DELIVERED
  FAILED
}

// Metadata only: never copy user-entered text, audit snapshots or wearable data.
model OutboxEvent {
  id             String           @id
  auditEventId   String           @unique
  eventType      String
  version        Int              @default(1)
  actorId        String
  organizationId String?
  targetType     String
  targetId       String
  correlationId  String
  createdAt      DateTime         @default(now())
  status         OutboxStatus     @default(PENDING)
  attempts       Int              @default(0)
  availableAt    DateTime         @default(now())
  deliveredAt    DateTime?
  lastErrorCode  String?
  durationMs     Int?
  notices        CommerceNotice[]
  receipt        EventReceipt?

  @@index([status, availableAt])
}

// Internal durable consumer; not evidence of external publication or commerce ETL.
model EventReceipt {
  eventId    String      @id
  event      OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  receivedAt DateTime    @default(now())
}

model CommercialRfq {
 pilotProposalRevisions PilotProposalRevision[]
  demoScenario DemoScenario?
  revisions              ProcurementRevision[]
  activities             ProcurementActivity[]
  attachments            ProcurementAttachment[]
  questions              ProcurementQuestion[]
  messages               ProcurementMessage[]
  samples                ProcurementSample[]
  quotes                 ProcurementQuote[]
  products               ApprovedProductVersion[] @relation("ProductSource")
  documents              ProcurementDocument[]
  feasibilityAssessments FeasibilityAssessment[]
  costEstimates          CostEstimate[]
  procurementManaged     Boolean                  @default(false)
  sourceProductId        String?
  sourceProduct          ApprovedProductVersion?  @relation("ReorderSource", fields: [sourceProductId], references: [id], onDelete: Restrict)
  id                     String                   @id @default(cuid())
  buyerOrganizationId    String
  buyerOrganization      Organization             @relation("RfqBuyer", fields: [buyerOrganizationId], references: [id], onDelete: Restrict)
  operatorOrganizationId String
  operatorOrganization   Organization             @relation("RfqOperator", fields: [operatorOrganizationId], references: [id], onDelete: Restrict)
  craftSkillId           String
  craftSkill             CraftSkill               @relation(fields: [craftSkillId], references: [id], onDelete: Restrict)
  title                  String
  specification          String
  designRequirements     String
  quantity               Int
  deliveryAt             DateTime
  deliveryLocation       String
  status                 String                   @default("DRAFT")
  version                Int                      @default(1)
  provenance             String                   @default("SYNTHETIC")
  quoteMillimes          BigInt?
  quoteExpiresAt         DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  order                  CommercialOrder?

  @@index([buyerOrganizationId, createdAt])
  @@index([operatorOrganizationId, status])
}

model CommercialOrder {
 financeRecordEvents FinanceRecordEvent[]
  products          ApprovedProductVersion[]
  documents         ProcurementDocument[]
  acceptance        ProcurementAcceptance?
  projection        CommerceProjection?
  id                String                   @id @default(cuid())
  rfqId             String                   @unique
  rfq               CommercialRfq            @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  status            String                   @default("APPROVED")
  version           Int                      @default(1)
  delivered         Int                      @default(0)
  materialsResolved Boolean                  @default(false)
  dispositionNote   String?
  provenance        String                   @default("SYNTHETIC")
  createdAt         DateTime                 @default(now())
  offers            CommercialOffer[]
  batches           CommercialBatch[]
  payments          SyntheticPayment[]
  eligibilityAssessments EligibilityAssessment[]
  shipmentPreparations ShipmentPreparation[]
  productionEvents     ProductionLedgerEvent[]
  shipments            Shipment[]
  traceability         TraceabilityPublication[]
  payables             ArtisanPayable[]
  settlements          SimulatedSettlement[]
  recommendationSnapshots RecommendationSnapshot[]
  allocationPlans       AllocationPlan[]
  scheduleScenarios     ScheduleScenario[]
  discussions        OrderDiscussion[]
  exceptions         ProductionException[]
  scheduleRevisions  ScheduleRevision[]
  catalogueProcurementRevisionId String? @unique
  catalogueProcurementRevision ProcurementRevision? @relation("CatalogueOrderRevision", fields: [catalogueProcurementRevisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  productSpecificationRevisionId String?
  productSpecificationRevision   ProductSpecificationRevision? @relation(fields: [productSpecificationRevisionId], references: [id], onDelete: Restrict)
  buyerFeedback      BuyerOrderFeedback[] @relation("BuyerFeedbackOrder")
  @@index([productSpecificationRevisionId])
}

model CommercialOffer {
  id                    String              @id @default(cuid())
  orderId               String
  order                 CommercialOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  capacityDeclarationId String
  capacityDeclaration   CapacityDeclaration @relation(fields: [capacityDeclarationId], references: [id], onDelete: Restrict)
  artisanProfileId      String
  artisanProfile        ArtisanProfile      @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  quantity              Int
  unitPayMillimes       BigInt
  estimatedHours        String
  expiresAt             DateTime
  deliveryDeadline      DateTime?
  materials             String
  reworkTerms           String
  paymentConditions     String
  status                String              @default("PLANNED")
  version               Int                 @default(1)
  provenance            String              @default("SYNTHETIC")
  acceptedAt            DateTime?
  decidedByUserId       String?
  createdAt             DateTime            @default(now())
  quoteId               String?
  quote                 ProcurementQuote?   @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  eligibilityAssessmentId String?
  eligibilityAssessment EligibilityAssessment? @relation(fields: [eligibilityAssessmentId], references: [id], onDelete: Restrict)
  compensationMethod    String?
  collectionArrangement String?
  instructions          String?
  termsSha256           String?
  associationOrganizationId String?
  association           Organization?       @relation(fields: [associationOrganizationId], references: [id], onDelete: Restrict)
  batch                 CommercialBatch?
  assistedDecision      AssistedOfferDecision?
  payables              ArtisanPayable[]

  @@index([orderId, status])
  @@index([artisanProfileId, status])
  @@index([capacityDeclarationId, status])
  @@index([eligibilityAssessmentId])
  allocationItem AllocationPlanItem?
  counteroffers      Counteroffer[]
  revisedCounteroffer Counteroffer? @relation("RevisedCounterOffer")
  samplePayables    SamplePayable[] @relation("SamplePayableOffer")
}

model CommercialBatch {
  id               String                 @id @default(cuid())
  orderId          String
  order            CommercialOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  offerId          String                 @unique
  offer            CommercialOffer        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  artisanProfileId String
  artisanProfile   ArtisanProfile         @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  status           String                 @default("ACCEPTED")
  version          Int                    @default(1)
  produced         Int                    @default(0)
  submitted        Int                    @default(0)
  approved         Int                    @default(0)
  rejected         Int                    @default(0)
  pending          Int                    @default(0)
  provenance       String                 @default("SYNTHETIC")
  createdAt        DateTime               @default(now())
  inspections      CommercialInspection[]
  payments         SyntheticPayment[]
  revisionId       String?
  revision         ProcurementRevision?        @relation("LockedBatchRevision", fields: [revisionId], references: [id], onDelete: Restrict)
  release          BatchRelease?
  materialRequirements BatchMaterialRequirement[]
  progressEvents   ProductionProgressEvent[]
  productionEvents ProductionLedgerEvent[]
  qualityAttempts  QualityInspectionAttempt[]
  preparationItems ShipmentPreparationItem[]
  payables         ArtisanPayable[]

  @@index([orderId])
  @@index([artisanProfileId, status])
  @@index([revisionId])
  exceptions         ProductionException[]
  scheduleRevisions  ScheduleRevision[]
  forecasts         ForecastSnapshot[]
  timeRecords       ProductionTimeRecord[]
  alerts            BatchAlert[]
}

model CommercialInspection {
  id           String          @id @default(cuid())
  batchId      String
  batch        CommercialBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  batchVersion Int
  inspectorId  String
  approved     Int
  rejected     Int
  pending      Int
  submitted    Int
  defectReason String
  createdAt    DateTime        @default(now())

  @@unique([batchId, batchVersion])
}

model SpecificationMaterialLine {
  id           String              @id @default(cuid())
  revisionId   String
  revision     ProcurementRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  materialCode String
  name         String
  unit         String
  perItemMilli Int
  wastageBps   Int                 @default(0)
  createdAt    DateTime            @default(now())

  @@unique([revisionId, materialCode])
}

model InspectionCriterion {
  id               String                      @id @default(cuid())
  revisionId       String
  revision         ProcurementRevision         @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  code             String
  description      String
  expected         String
  tolerance        String                      @default("")
  required         Boolean
  evidenceRequired Boolean                     @default(false)
  version          Int                         @default(1)
  createdAt        DateTime                    @default(now())
  results          InspectionCriterionResult[]

  @@unique([revisionId, code])
}

model BatchRelease {
  id                  String                     @id @default(cuid())
  batchId             String                     @unique
  batch               CommercialBatch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  actorId             String
  actor               User                       @relation("BatchReleaseActor", fields: [actorId], references: [id], onDelete: Restrict)
  revisionId          String
  revision            ProcurementRevision        @relation("ReleaseRevision", fields: [revisionId], references: [id], onDelete: Restrict)
  sampleId            String
  sample              ProcurementSample          @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  fundingAttestation  String
  materialAttestation String
  createdAt           DateTime                   @default(now())
  requirements        BatchMaterialRequirement[]
}

model BatchMaterialRequirement {
  id             String          @id @default(cuid())
  batchId        String
  batch          CommercialBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  releaseId      String
  release        BatchRelease    @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  materialCode   String
  name           String
  unit           String
  perItemMilli   Int
  wastageBps     Int
  batchQuantity  Int
  requiredMilli  Int
  readiness      String
  createdAt      DateTime        @default(now())

  @@unique([batchId, materialCode])
}

model ProductionProgressEvent {
  id                        String                    @id @default(cuid())
  batchId                   String
  batch                     CommercialBatch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  artisanProfileId          String
  artisan                   ArtisanProfile            @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  actorId                   String
  actor                     User                      @relation("ProgressReporter", fields: [actorId], references: [id], onDelete: Restrict)
  associationOrganizationId String?
  association               Organization?             @relation("ProgressAssociation", fields: [associationOrganizationId], references: [id], onDelete: Restrict)
  kind                      String
  mode                      String
  source                    String
  cumulative                Int
  previousCumulative        Int
  delta                     Int
