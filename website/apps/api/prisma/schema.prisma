model ArtisanPayable {
 contractualDates ContractualDueDate[]
  id                String           @id @default(cuid())
  offerId           String?
  offer             CommercialOffer? @relation(fields: [offerId], references: [id], onDelete: Restrict)
  orderId           String?
  order             CommercialOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  batchId           String?
  batch             CommercialBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  artisanProfileId  String
  artisanProfile    ArtisanProfile   @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  milestone         String
  policyVersion     Int
  quantity          Int
  unitPayMillimes   BigInt
  amountMillimes    BigInt
  currency          String           @default("TND")
  status            String           @default("RECOGNIZED")
  sourceEventId     String
  termsSnapshot     String
  provenance        String           @default("SYNTHETIC")
  createdAt         DateTime         @default(now())
  settlements       SimulatedSettlement[]
  // Real payout evidence. `PayoutRequest_payableId_fkey` already exists in the database
  // (20261027080000_financial_controls); these back-relations expose it to Prisma so verified
  // payment evidence can be read from the payable without a schema migration.
  payouts           PayoutRequest[]
  sampleRequestId   String? @unique
  sampleRequest     ProductSampleRequest? @relation("SampleLedger", fields: [sampleRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([batchId, milestone, sourceEventId])
  @@index([orderId])
  @@index([artisanProfileId])
}

