/* ---------------------------------------------------------------- Batch 8: production planning
 * Explainable recommendations, reviewed multi-group allocations, human overrides and schedule
 * scenarios. Recommendations and simulations are advisory; artisan acceptance remains the only
 * way capacity becomes committed.
 */

model RecommendationPolicy {
  id        String   @id @default(cuid())
  version   Int      @unique
  name      String
  inputs    Json
  excluded  Json
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  snapshots RecommendationSnapshot[]
}

model RecommendationSnapshot {
  id               String               @id @default(cuid())
  policyId         String
  policy           RecommendationPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  orderId          String
  order            CommercialOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requiredQuantity Int
  craftSkillId     String
  candidates       Json
  suggestion       Json
  limitations      Json
  authorId         String
  author           User                 @relation("RecommendationAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())
  plans            AllocationPlan[]

  @@index([orderId, createdAt])
}

model AllocationPlan {
  id                  String                 @id @default(cuid())
  orderId             String
  order               CommercialOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  version             Int                    @default(1)
  state               String                 @default("DRAFT")
  requiredQuantity    Int
  materialAssumptions Json @default("{}")
  policyVersion       Int
  recommendationId    String?
  recommendation      RecommendationSnapshot? @relation(fields: [recommendationId], references: [id], onDelete: Restrict)
  authorId            String
  author              User                   @relation("AllocationPlanAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewedById        String?
  reviewedBy          User?                  @relation("AllocationPlanReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  items               AllocationPlanItem[]
  overrides           AllocationOverride[]

  @@unique([orderId, version])
  @@index([orderId, state])
}

model AllocationPlanItem {
  id               String         @id @default(cuid())
  planId           String
  plan             AllocationPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  artisanProfileId String
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  quantity         Int
  state            String         @default("DRAFT")
  offerId          String?        @unique
  offer            CommercialOffer? @relation(fields: [offerId], references: [id], onDelete: Restrict)
  releasedQuantity Int            @default(0)
  replacementForId String?        @unique
  replacementFor   AllocationPlanItem? @relation("AllocationReplacement", fields: [replacementForId], references: [id], onDelete: Restrict)
  replacedBy       AllocationPlanItem? @relation("AllocationReplacement")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([planId, artisanProfileId])
  @@index([planId, state])
  @@index([artisanProfileId, state])
}

model AllocationOverride {
  id                     String         @id @default(cuid())
  planId                 String
  plan                   AllocationPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  originalRecommendation Json
  selectedAlternative    Json
  actingUserId           String
  actingUser             User           @relation("OverrideActor", fields: [actingUserId], references: [id], onDelete: Restrict)
  businessScope          String
  explanation            String
  decisionVersion        Int
  createdAt              DateTime       @default(now())

  @@index([planId, createdAt])
}

model ScheduleScenario {
  id               String          @id @default(cuid())
  orderId          String
  order            CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  planId           String?
  name             String
  requiredQuantity Int
  startDate        DateTime
  deadline         DateTime
  result           Json
  assumptions      Json
  policyVersion    Int
  authorId         String
  author           User            @relation("ScheduleScenarioAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt        DateTime        @default(now())

  @@index([orderId, createdAt])
}

/* ---------------------------------------------------------------- Batch 9: product catalog
 * Versioned product specifications with append-only revision history, paid sample terms and a
 * single coherent buyer sample approval. Existing ProcurementRevision/ProcurementSample stay the
 * authority for an accepted order's design evidence; these models add the design lifecycle those
 * records reference, without creating a second product truth.
 */

model ProductSpecification {
  id           String   @id @default(cuid())
  craftSkillId String
  craftSkill   CraftSkill @relation(fields: [craftSkillId], references: [id], onDelete: Restrict)
